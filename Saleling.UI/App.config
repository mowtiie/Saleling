<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<appSettings>
		<!-- Which connection string below to use: LocalDb or SqlExpress. The SALELING_DB_PROFILE environment variable overrides this. -->
		<add key="DatabaseProfile" value="LocalDb"/>
	</appSettings>
	<connectionStrings>
		<add
			 name="LocalDb"
			 connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=Saleling.DB;Integrated Security=True"
			 providerName="Microsoft.Data.SqlClient"/>
		<add
			 name="SqlExpress"
			 connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=Saleling.DB;Integrated Security=True;TrustServerCertificate=True"
			 providerName="Microsoft.Data.SqlClient"/>
	</connectionStrings>
</configuration>
