<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<connectionStrings>
		<!-- Repositories read this when constructed but never connect in these tests. -->
		<add
			 name="SalelingDB"
			 connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=Saleling.DB.Tests;Integrated Security=True"
			 providerName="System.Data.SqlClient"/>
	</connectionStrings>
</configuration>
